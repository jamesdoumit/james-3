* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f8f5f0;
    color: #29231f;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 8%;
}

nav {
    display: flex;
    gap: 25px;
}

nav a {
    text-decoration: none;
    color: #29231f;
}

.hero {
    min-height: 80vh;
    padding: 80px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.hero h1 {
    font-size: 70px;
    line-height: 1;
    margin-bottom: 25px;
}

.hero p {
    font-size: 18px;
    max-width: 500px;
    margin-bottom: 25px;
}

button {
    background: #29231f;
    color: white;
    border: none;
    padding: 15px 30px;
    border-radius: 30px;
    cursor: pointer;
    font-size: 16px;
}

button:hover {
    background: #9b5c35;
}

.coffee {
    font-size: 180px;
    background: #dbc0a8;
    width: 350px;
    height: 350px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
}

#about {
    background: #29231f;
    color: white;
    padding: 100px 8%;
    text-align: center;
}

#about h2 {
    font-size: 40px;
    margin-bottom: 15px;
}

footer {
    background: #29231f;
    color: white;
    text-align: center;
    padding: 25px;
}
